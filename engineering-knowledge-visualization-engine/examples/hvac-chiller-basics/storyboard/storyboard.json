      "explanationStyle": "label-and-function",
      "emphasisPoints": [
        "Evaporator - where cooling happens",
        "Compressor - drives the cycle",
        "Condenser - where heat is rejected",
        "Expansion valve - reduces pressure"
      ]
    },
