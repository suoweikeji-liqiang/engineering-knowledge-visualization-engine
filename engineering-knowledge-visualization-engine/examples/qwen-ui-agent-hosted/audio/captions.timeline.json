{
  "schemaVersion": "1.0",
  "storySlug": "qwen-ui-agent-hosted",
  "cues": [
    {
      "start": 0.25,
      "end": 3.2760451127819548,
      "localStart": 0.25,
      "localEnd": 3.2760451127819548,
      "text": "晚上十点，手机突然弹出一条通知：",
      "shotId": "cold-open"
    },
    {
      "start": 3.2760451127819548,
      "end": 4.978195488721805,
      "localStart": 3.2760451127819548,
      "localEnd": 4.978195488721805,
      "text": "明早的航班取消了。",
      "shotId": "cold-open"
    },
    {
      "start": 4.978195488721805,
      "end": 8.571624060150377,
      "localStart": 4.978195488721805,
      "localEnd": 8.571624060150377,
      "text": "你真正需要的不是一个会点按钮的 AI，",
      "shotId": "cold-open"
    },
    {
      "start": 8.571624060150377,
      "end": 10.462902255639099,
      "localStart": 8.571624060150377,
      "localEnd": 10.462902255639099,
      "text": "而是有人先看懂影响，",
      "shotId": "cold-open"
    },
    {
      "start": 10.462902255639099,
      "end": 12.921563909774438,
      "localStart": 10.462902255639099,
      "localEnd": 12.921563909774438,
      "text": "再把可选方案整理到你面前。",
      "shotId": "cold-open"
    },
    {
      "start": 12.921563909774438,
      "end": 16.51499248120301,
      "localStart": 12.921563909774438,
      "localEnd": 16.51499248120301,
      "text": "Qwen UI Agent 的新演示，",
      "shotId": "cold-open"
    },
    {
      "start": 16.51499248120301,
      "end": 18.21714285714286,
      "localStart": 16.51499248120301,
      "localEnd": 18.21714285714286,
      "text": "就从这个意外开始。",
      "shotId": "cold-open"
    },
    {
      "start": 18.467142857142857,
      "end": 22.12793103448276,
      "localStart": 0.25,
      "localEnd": 3.910788177339903,
      "text": "通知不是终点，而是触发信号。演示里，",
      "shotId": "official-demo"
    },
    {
      "start": 22.12793103448276,
      "end": 25.99209633278599,
      "localStart": 3.910788177339903,
      "localEnd": 7.774953475643134,
      "text": "Agent 先读取取消信息和相关日程，",
      "shotId": "official-demo"
    },
    {
      "start": 25.99209633278599,
      "end": 30.263015873015874,
      "localStart": 7.774953475643134,
      "localEnd": 12.045873015873017,
      "text": "再主动提出查找替代交通方案。注意这个顺序：",
      "shotId": "official-demo"
    },
    {
      "start": 30.263015873015874,
      "end": 34.1271811713191,
      "localStart": 12.045873015873017,
      "localEnd": 15.910038314176244,
      "text": "先理解影响，再给计划；涉及重新预订时，",
      "shotId": "official-demo"
    },
    {
      "start": 34.1271811713191,
      "end": 36.16095238095238,
      "localStart": 15.910038314176244,
      "localEnd": 17.943809523809524,
      "text": "它把决定权交回用户。",
      "shotId": "official-demo"
    },
    {
      "start": 36.41095238095238,
      "end": 39.868595974472264,
      "localStart": 0.25,
      "localEnd": 3.707643593519883,
      "text": "这背后多了一层轻量 Harness。",
      "shotId": "proactive-loop"
    },
    {
      "start": 39.868595974472264,
      "end": 41.21323514973,
      "localStart": 3.707643593519883,
      "localEnd": 5.052282768777616,
      "text": "它把现实信号、",
      "shotId": "proactive-loop"
    },
    {
      "start": 41.21323514973,
      "end": 45.247152675503195,
      "localStart": 5.052282768777616,
      "localEnd": 9.086200294550814,
      "text": "用户上下文和持续状态交给 Planner：",
      "shotId": "proactive-loop"
    },
    {
      "start": 45.247152675503195,
      "end": 49.08897889052528,
      "localStart": 9.086200294550814,
      "localEnd": 12.928026509572902,
      "text": "感知事件，推演影响，准备方案，等待确认，",
      "shotId": "proactive-loop"
    },
    {
      "start": 49.08897889052528,
      "end": 52.35453117329406,
      "localStart": 12.928026509572902,
      "localEnd": 16.193578792341683,
      "text": "然后继续执行。小兰现在指的这条线，",
      "shotId": "proactive-loop"
    },
    {
      "start": 52.35453117329406,
      "end": 55.04380952380953,
      "localStart": 16.193578792341683,
      "localEnd": 18.882857142857148,
      "text": "才是主动服务真正发生的地方。",
      "shotId": "proactive-loop"
    },
    {
      "start": 55.29380952380953,
      "end": 58.994285714285716,
      "localStart": 0.25,
      "localEnd": 3.950476190476188,
      "text": "接下来它并不执着于模拟人的每一次点击。",
      "shotId": "hybrid-actions"
    },
    {
      "start": 58.994285714285716,
      "end": 61.52619047619048,
      "localStart": 3.950476190476188,
      "localEnd": 6.48238095238095,
      "text": "适合界面的步骤用 GUI，",
      "shotId": "hybrid-actions"
    },
    {
      "start": 61.52619047619048,
      "end": 64.64238095238096,
      "localStart": 6.48238095238095,
      "localEnd": 9.598571428571432,
      "text": "搜索和结构化数据可以走 API，",
      "shotId": "hybrid-actions"
    },
    {
      "start": 64.64238095238096,
      "end": 67.17428571428573,
      "localStart": 9.598571428571432,
      "localEnd": 12.130476190476202,
      "text": "处理文件时再切到 CLI；",
      "shotId": "hybrid-actions"
    },
    {
      "start": 67.17428571428573,
      "end": 70.87476190476193,
      "localStart": 12.130476190476202,
      "localEnd": 15.830952380952397,
      "text": "多个确定动作还能批量发出。真正的升级，",
      "shotId": "hybrid-actions"
    },
    {
      "start": 70.87476190476193,
      "end": 73.7961904761905,
      "localStart": 15.830952380952397,
      "localEnd": 18.752380952380975,
      "text": "是为目标选择更合适的动作通道。",
      "shotId": "hybrid-actions"
    },
    {
      "start": 74.04619047619047,
      "end": 77.9519540229885,
      "localStart": 0.25,
      "localEnd": 4.155763546798028,
      "text": "更关键的是，任务不会被锁在一块屏幕里。",
      "shotId": "cross-platform"
    },
    {
      "start": 77.9519540229885,
      "end": 80.00761904761904,
      "localStart": 4.155763546798028,
      "localEnd": 6.21142857142857,
      "text": "手机负责通知和确认，",
      "shotId": "cross-platform"
    },
    {
      "start": 80.00761904761904,
      "end": 84.11894909688013,
      "localStart": 6.21142857142857,
      "localEnd": 10.322758620689655,
      "text": "浏览器或 DeepSearch 查资料，",
      "shotId": "cross-platform"
    },
    {
      "start": 84.11894909688013,
      "end": 88.43584564860427,
      "localStart": 10.322758620689655,
      "localEnd": 14.639655172413796,
      "text": "电脑更新表格和会议，再把结果送回相关的人。",
      "shotId": "cross-platform"
    },
    {
      "start": 88.43584564860427,
      "end": 91.9304761904762,
      "localStart": 14.639655172413796,
      "localEnd": 18.134285714285724,
      "text": "平台变了，但同一份任务状态没有断。",
      "shotId": "cross-platform"
    },
    {
      "start": 92.18047619047618,
      "end": 97.07440476190476,
      "localStart": 0.25,
      "localEnd": 5.1439285714285745,
      "text": "这类跨端任务很长，局部点对并不代表最后做完。",
      "shotId": "long-horizon"
    },
    {
      "start": 97.07440476190476,
      "end": 102.41323593073592,
      "localStart": 5.1439285714285745,
      "localEnd": 10.482759740259738,
      "text": "技术报告把在线强化学习推进到超过一百个交互步骤，",
      "shotId": "long-horizon"
    },
    {
      "start": 102.41323593073592,
      "end": 105.9724567099567,
      "localStart": 10.482759740259738,
      "localEnd": 14.041980519480518,
      "text": "并用大约一万个并行环境加速训练。",
      "shotId": "long-horizon"
    },
    {
      "start": 105.9724567099567,
      "end": 110.42148268398267,
      "localStart": 14.041980519480518,
      "localEnd": 18.49100649350649,
      "text": "重点不是数字更大，而是专门训练中途观察、",
      "shotId": "long-horizon"
    },
    {
      "start": 110.42148268398267,
      "end": 111.75619047619047,
      "localStart": 18.49100649350649,
      "localEnd": 19.825714285714284,
      "text": "修正和继续。",
      "shotId": "long-horizon"
    },
    {
      "start": 112.00619047619047,
      "end": 117.33977558839626,
      "localStart": 0.25,
      "localEnd": 5.583585112205796,
      "text": "把宣传词放到一边，报告第五页给出了完整轨迹：",
      "shotId": "primary-evidence"
    },
    {
      "start": 117.33977558839626,
      "end": 121.46118226600984,
      "localStart": 5.583585112205796,
      "localEnd": 9.704991789819374,
      "text": "通知触发，查询替代航班，用户批准，",
      "shotId": "primary-evidence"
    },
    {
      "start": 121.46118226600984,
      "end": 126.79476737821564,
      "localStart": 9.704991789819374,
      "localEnd": 15.03857690202517,
      "text": "手机重新预订，电脑更新会议，最后发送新文件。",
      "shotId": "primary-evidence"
    },
    {
      "start": 126.79476737821564,
      "end": 129.703995621237,
      "localStart": 15.03857690202517,
      "localEnd": 17.94780514504653,
      "text": "小兰标出的不是一句口号，",
      "shotId": "primary-evidence"
    },
    {
      "start": 129.703995621237,
      "end": 133.09809523809523,
      "localStart": 17.94780514504653,
      "localEnd": 21.341904761904757,
      "text": "而是一条可以逐段核对的闭环。",
      "shotId": "primary-evidence"
    },
    {
      "start": 133.34809523809523,
      "end": 134.94703296703295,
      "localStart": 0.25,
      "localEnd": 1.8489377289377273,
      "text": "评测也要分场景看。",
      "shotId": "benchmarks"
    },
    {
      "start": 134.94703296703295,
      "end": 139.9215059015059,
      "localStart": 1.8489377289377273,
      "localEnd": 6.8234106634106695,
      "text": "报告给出的结果包括 MobileWorld 八十二点一，",
      "shotId": "benchmarks"
    },
    {
      "start": 139.9215059015059,
      "end": 142.05342287342287,
      "localStart": 6.8234106634106695,
      "localEnd": 8.955327635327649,
      "text": "真实手机任务九十二点二，",
      "shotId": "benchmarks"
    },
    {
      "start": 142.05342287342287,
      "end": 146.13959706959707,
      "localStart": 8.955327635327649,
      "localEnd": 13.041501831501847,
      "text": "OSWorld Verified 七十九点五，",
      "shotId": "benchmarks"
    },
    {
      "start": 146.13959706959707,
      "end": 149.33747252747253,
      "localStart": 13.041501831501847,
      "localEnd": 16.239377289377302,
      "text": "以及 WebArena 七十三点六。",
      "shotId": "benchmarks"
    },
    {
      "start": 149.33747252747253,
      "end": 151.4693894993895,
      "localStart": 16.239377289377302,
      "localEnd": 18.37129426129428,
      "text": "它们不能直接互相比高低，",
      "shotId": "benchmarks"
    },
    {
      "start": 151.4693894993895,
      "end": 154.1342857142857,
      "localStart": 18.37129426129428,
      "localEnd": 21.036190476190484,
      "text": "但共同说明能力覆盖了不同界面。",
      "shotId": "benchmarks"
    },
    {
      "start": 154.3842857142857,
      "end": 155.0063033873343,
      "localStart": 0.25,
      "localEnd": 0.8720176730485889,
      "text": "所以，",
      "shotId": "synthesis"
    },
    {
      "start": 155.0063033873343,
      "end": 160.81180166912125,
      "localStart": 0.8720176730485889,
      "localEnd": 6.677515954835542,
      "text": "Qwen UI Agent 值得看的不是它会不会点屏幕，",
      "shotId": "synthesis"
    },
    {
      "start": 160.81180166912125,
      "end": 163.09253313696613,
      "localStart": 6.677515954835542,
      "localEnd": 8.958247422680415,
      "text": "而是它正把感知、计划、",
      "shotId": "synthesis"
    },
    {
      "start": 163.09253313696613,
      "end": 166.6172999509082,
      "localStart": 8.958247422680415,
      "localEnd": 12.483014236622495,
      "text": "确认和跨端执行接成现实事务的闭环。",
      "shotId": "synthesis"
    },
    {
      "start": 166.6172999509082,
      "end": 171.17876288659795,
      "localStart": 12.483014236622495,
      "localEnd": 17.04447717231224,
      "text": "航班取消这件事最终仍由人拍板；AI 的价值，",
      "shotId": "synthesis"
    },
    {
      "start": 171.17876288659795,
      "end": 174.4961904761905,
      "localStart": 17.04447717231224,
      "localEnd": 20.361904761904782,
      "text": "是把混乱提前整理成可行动的选择。",
      "shotId": "synthesis"
    }
  ]
}
