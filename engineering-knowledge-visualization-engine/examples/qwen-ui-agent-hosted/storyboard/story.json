      "hostNarrative": {"role": "warn", "mode": "host-evidence", "hostOnScreen": true, "asset": "xiaolan-thinking.png", "action": "标记报告中的完整跨端轨迹", "rig": {"system": "xiaolan-rig-v1", "pose": "thinking", "action": "think-focus", "lipSync": "voice-rms"}},
