      "visual": {"kind": "swimlane", "lanes": ["MODEL", "HARNESS", "TOOLS"], "events": [{"from": "HARNESS", "to": "MODEL", "label": "goal + constraints", "semanticType": "request"}, {"from": "MODEL", "to": "HARNESS", "label": "tool_call search_sources", "semanticType": "model-decision"}, {"from": "HARNESS", "to": "TOOLS", "label": "schema + network policy", "semanticType": "validated-action"}, {"from": "TOOLS", "to": "HARNESS", "label": "12 results", "semanticType": "raw-result"}, {"from": "HARNESS", "to": "MODEL", "label": "4 primary sources", "semanticType": "observation"}, {"from": "MODEL", "to": "HARNESS", "label": "state diff: script running", "semanticType": "state-update"}], "cueIndexes": [1, 3, 4, 5, 5, 7], "continuityKey": "live-trace"},
