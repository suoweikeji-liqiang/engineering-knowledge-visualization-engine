  "narrationIntents": [
    {
      "schemaVersion": "1.0",
      "id": "narration-scene-01-control-problem",
      "goal": "Understand why PID control is needed in HVAC",
      "audienceLevel": "intermediate",
      "explanationStyle": "purpose-context-first",
      "emphasisPoints": [
        "Need to maintain temperature at setpoint",
        "Disturbances cause deviations",
        "Simple on/off control causes oscillations"
      ]
    },
    {
      "schemaVersion": "1.0",
      "id": "narration-scene-02-proportional-control",
      "goal": "Learn how proportional gain responds to error",
      "audienceLevel": "intermediate",
      "explanationStyle": "feedback-first",
      "emphasisPoints": [
        "Control output proportional to error",
        "Larger error = stronger response",
        "Leaves steady-state error"
      ]
    },
    {
      "schemaVersion": "1.0",
      "id": "narration-scene-03-integral-control",
      "goal": "Understand how integral action eliminates steady-state error",
      "audienceLevel": "intermediate",
      "explanationStyle": "feedback-first",
      "emphasisPoints": [
        "Accumulates error over time",
        "Eliminates offset",
        "Can cause overshoot if too aggressive"
      ]
    },
    {
      "schemaVersion": "1.0",
      "id": "narration-scene-04-derivative-control",
      "goal": "Learn how derivative action dampens oscillations",
      "audienceLevel": "intermediate",
      "explanationStyle": "feedback-first",
      "emphasisPoints": [
        "Responds to rate of change",
        "Anticipates future error",
        "Reduces overshoot and settling time"
      ]
    },
    {
      "schemaVersion": "1.0",
      "id": "narration-scene-05-summary",
      "goal": "Recap PID control principles",
      "audienceLevel": "intermediate",
      "explanationStyle": "recap-and-transfer",
      "emphasisPoints": [
        "P responds to current error",
        "I eliminates steady-state error",
        "D dampens oscillations",
        "Tuning balances speed and stability"
      ]
    }
  ],
