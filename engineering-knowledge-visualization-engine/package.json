{
  "name": "engineering-knowledge-visualization-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Engineering Knowledge Visualization Engine",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "node scripts/build.ts",
    "bootstrap": "node scripts/bootstrap.ts",
    "lint": "echo 'lint not configured yet'",
    "examples:generate": "tsx scripts/generate-example-artifacts.ts",
    "benchmark:audio": "PYTHONPATH=../sandiao-science-studio/src python3 -m sandiao_studio audio examples/ai-agent-harness-benchmark/storyboard/story.json --tts-provider mimo",
    "benchmark:render": "pnpm --filter @repo/renderer-revideo render:benchmark",
    "typecheck": "tsc -p tsconfig.base.json --noEmit"
  },
  "dependencies": {
    "@repo/schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
