{
  "name": "engineering-knowledge-visualization-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Engineering Knowledge Visualization Engine",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "node scripts/build.ts",
    "bootstrap": "node scripts/bootstrap.ts",
    "lint": "echo 'lint not configured yet'",
    "examples:generate": "tsx scripts/generate-example-artifacts.ts",
    "benchmark:audio": "PYTHONPATH=../sandiao-science-studio/src python3 -m sandiao_studio audio examples/ai-agent-harness-benchmark/storyboard/story.json --tts-provider mimo",
    "benchmark:render": "pnpm --filter @repo/renderer-revideo render:benchmark",
    "benchmark:complete:validate": "node scripts/validate-complete-benchmark.mjs && tsx scripts/validate-complete-layout.ts",
    "benchmark:complete:audio": "PYTHONPATH=../sandiao-science-studio/src python3 -m sandiao_studio audio examples/ai-agent-harness-complete/storyboard/story.json --tts-provider mimo",
    "benchmark:complete:align": "python3 scripts/align-complete-audio.py",
    "benchmark:complete:subtitles": "node scripts/generate-complete-subtitles.mjs",
    "benchmark:complete:visual-cues": "node scripts/generate-complete-visual-cues.mjs",
    "benchmark:complete:trace": "node scripts/generate-complete-trace.mjs",
    "benchmark:complete:asr": "python3 scripts/review-complete-asr.py",
    "benchmark:complete:qa": "tsx scripts/validate-complete-layout.ts && node scripts/qa-complete-benchmark.mjs",
    "benchmark:complete:render": "pnpm benchmark:complete:subtitles && pnpm benchmark:complete:visual-cues && pnpm benchmark:complete:validate && pnpm --filter @repo/renderer-revideo render:complete",
    "qwen-ui-agent:audio": "PYTHONPATH=../sandiao-science-studio/src python3 -m sandiao_studio audio examples/qwen-ui-agent-hosted/storyboard/story.json --tts-provider mimo && node scripts/generate-qwen-ui-agent-subtitles.mjs",
    "qwen-ui-agent:render": "pnpm --filter @repo/renderer-revideo render:qwen-ui-agent",
    "qwen-ui-agent:asr": "ASR_STORY_SLUG=qwen-ui-agent-hosted python3 scripts/review-complete-asr.py",
    "qwen-ui-agent:qa": "node scripts/qa-qwen-ui-agent.mjs",
    "typecheck": "tsc -p tsconfig.base.json --noEmit"
  },
  "dependencies": {
    "@repo/schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
