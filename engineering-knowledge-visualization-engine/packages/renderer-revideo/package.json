{
  "name": "@repo/renderer-revideo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "editor": "revideo editor --projectFile ./src/project.tsx",
    "editor:complete": "revideo editor --projectFile ./src/complete-project.tsx",
    "prepare:benchmark": "tsx src/prepare.ts",
    "prepare:complete": "tsx src/prepare-complete.ts",
    "render:benchmark": "tsx src/prepare.ts && tsx src/render.ts",
    "render:complete": "tsx src/prepare-complete.ts && tsx src/render-complete.ts"
  },
  "dependencies": {
    "@repo/schemas": "workspace:*",
    "@revideo/2d": "0.11.0",
    "@revideo/core": "0.11.0",
    "@revideo/renderer": "0.11.0"
  },
  "devDependencies": {
    "@revideo/cli": "0.11.0",
    "@revideo/ui": "0.11.0",
    "tsx": "^4.21.0",
    "typescript": "5.8.3",
    "vite": "^4.5.14"
  }
}
